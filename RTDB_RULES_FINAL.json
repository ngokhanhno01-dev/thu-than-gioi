{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      ".read": true,
      "$uid": {
        ".write": "(auth != null && auth.uid === $uid) && !root.child('banned').child(auth.uid).exists()",
        ".validate": "newData.hasChildren(['name', 't'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "lastSeen": {
      ".read": true,
      "$uid": {
        ".write": "(auth != null && auth.uid === $uid) && !root.child('banned').child(auth.uid).exists()",
        ".validate": "newData.val() === now"
      }
    },
    "chat": {
      ".read": true,
      ".indexOn": [
        "t"
      ],
      "$uid": {
        ".write": "(auth != null && auth.uid === $uid && newData.exists() && (!data.exists() || data.child('t').val() < now - 9000)) && !root.child('banned').child(auth.uid).exists()",
        ".validate": "newData.hasChildren(['name', 'text', 't'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "mail": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$mid": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && newData.child('claimed').val() === false",
          ".validate": "newData.hasChildren(['type', 'title', 'claimed', 't']) && newData.child('type').isString() && newData.child('title').isString() && newData.child('claimed').isBoolean()",
          "claimed": {
            ".write": "auth != null && auth.uid === $uid && data.val() === false && newData.val() === true && !root.child('banned').child(auth.uid).exists()",
            ".validate": "newData.isBoolean()"
          }
        }
      }
    },
    "seasonRank": {
      ".read": true,
      "$season": {
        ".indexOn": [
          "fame"
        ],
        "$uid": {
          ".write": "auth != null && ( (auth.uid === $uid && root.child('seasonCal').child($season).child('b').val() <= now && now < root.child('seasonCal').child($season).child('e').val() && newData.hasChildren(['nick', 'fame', 'lost', 'lv', 'wins', 'foes', 't']) && !root.child('banned').child(auth.uid).exists()) || (root.child('admins').child(auth.uid).val() === true && !newData.exists()) )",
          "nick": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
          },
          "fame": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && ( root.child('admins').child(auth.uid).val() === true || ( newData.val() <= 45 * (10 + (now - root.child('seasonCal').child($season).child('b').val()) / 1800000) + 60 + newData.parent().child('lost').val() && ( !data.exists() || newData.val() <= data.val() || ( data.parent().child('t').val() < now - 3000 && newData.val() <= data.val() + 135 ) ) ) )"
          },
          "lost": {
            ".write": "(auth != null && auth.uid !== $uid && data.exists() && root.child('arenaLog').child($uid).child(auth.uid).child('result').val() === 'win' && root.child('arenaLog').child($uid).child(auth.uid).child('t').val() > now - 30000 && root.child('arenaLog').child($uid).child(auth.uid).child('lost').val() > 0 && newData.val() === data.val() + root.child('arenaLog').child($uid).child(auth.uid).child('lost').val() && (!data.parent().child('prot').exists() || data.parent().child('prot').val() < now) && (!data.parent().child('lg').child(auth.uid).exists() || data.parent().child('lg').child(auth.uid).val() !== root.child('arenaLog').child($uid).child(auth.uid).child('t').val()) && newData.parent().child('lg').child(auth.uid).val() === root.child('arenaLog').child($uid).child(auth.uid).child('t').val() && newData.parent().child('prot').val() > now + 240000) && !root.child('banned').child(auth.uid).exists()",
            ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() >= data.val())"
          },
          "lv": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100"
          },
          "wins": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && ( root.child('admins').child(auth.uid).val() === true || newData.val() <= (10 + (now - root.child('seasonCal').child($season).child('b').val()) / 1800000) + 1 )"
          },
          "foes": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && ( root.child('admins').child(auth.uid).val() === true || newData.val() <= newData.parent().child('wins').val() )"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "hit": {
            ".write": "(auth != null && auth.uid !== $uid && data.parent().child('lost').exists() && root.child('arenaLog').child($uid).child(auth.uid).child('t').val() > now - 30000 && ((root.child('arenaLog').child($uid).child(auth.uid).child('result').val() === 'win' && (newData.val() === (data.exists() ? data.val() : 0) + 1 || newData.val() === 0)) || (root.child('arenaLog').child($uid).child(auth.uid).child('result').val() === 'lose' && newData.val() === 0))) && !root.child('banned').child(auth.uid).exists()",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9"
          },
          "prot": {
            ".write": "(auth != null && auth.uid !== $uid && data.parent().child('lost').exists() && root.child('arenaLog').child($uid).child(auth.uid).child('result').val() === 'win' && root.child('arenaLog').child($uid).child(auth.uid).child('t').val() > now - 30000 && newData.val() > now + 240000 && (newData.parent().child('hit').val() > 0 || newData.val() > now + 3000000)) && !root.child('banned').child(auth.uid).exists()",
            ".validate": "newData.isNumber() && (newData.val() === data.val() || (auth.uid !== $uid && newData.val() <= now + 3660000))"
          },
          "lg": {
            "$a": {
              ".write": "(auth != null && auth.uid === $a && auth.uid !== $uid && newData.val() === root.child('arenaLog').child($uid).child(auth.uid).child('t').val() && root.child('arenaLog').child($uid).child(auth.uid).child('t').val() > now - 30000) && !root.child('banned').child(auth.uid).exists()",
              ".validate": "newData.isNumber() && (newData.val() === data.val() || auth.uid === $a)"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "arenaLog": {
      "$defender": {
        ".read": "auth != null && auth.uid === $defender",
        ".indexOn": [
          "t"
        ],
        "$attacker": {
          ".read": "auth != null && auth.uid === $attacker",
          ".write": "(auth != null && auth.uid === $attacker && auth.uid !== $defender && newData.hasChildren(['name', 'result', 'lost', 'season', 't']) && (!data.exists() || data.child('t').val() < now - 3600000)) && !root.child('banned').child(auth.uid).exists()",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
          },
          "result": {
            ".validate": "newData.isString() && (newData.val() === 'win' || newData.val() === 'lose')"
          },
          "lost": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20 && (newData.parent().child('result').val() === 'win' || newData.val() === 0)"
          },
          "season": {
            ".validate": "newData.isNumber() && newData.val() >= 1"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "seasonResult": {
      ".read": true,
      "$season": {
        "$uid": {
          ".write": false
        }
      }
    },
    "titles": {
      "$uid": {
        ".read": true,
        "$season": {
          ".write": false
        }
      }
    },
    "banned": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['nick','why','by','t'])",
        "nick": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "why": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "by": {
          ".validate": "newData.isString()"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "reports": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$target": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && !newData.exists()",
        "$reporter": {
          ".read": "auth != null && auth.uid === $reporter",
          ".write": "auth != null && auth.uid === $reporter && $target !== auth.uid && !data.exists() && newData.exists() && !root.child('banned').child(auth.uid).exists()",
          ".validate": "$target.matches(/^[A-Za-z0-9]{20,40}$/) && newData.hasChildren(['r', 'n', 't'])",
          "r": {
            ".validate": "newData.isString() && (newData.val() === 'fame' || newData.val() === 'pet' || newData.val() === 'gold' || newData.val() === 'other')"
          },
          "n": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "seasonCal": {
      ".read": true,
      ".write": false
    },
    "flags": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && !data.exists() && !root.child('banned').child(auth.uid).exists()",
        ".validate": "newData.hasChildren(['c', 't'])",
        "c": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}